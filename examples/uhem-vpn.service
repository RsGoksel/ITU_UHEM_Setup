[Unit]
Description=Dedicated UHEM OpenVPN connection
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
ExecStart=/usr/sbin/openvpn --config /etc/openvpn/uhem/client.conf
Restart=on-failure
RestartSec=5
UMask=0077
PrivateTmp=true
ProtectHome=true

[Install]
WantedBy=multi-user.target
